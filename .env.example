# Required only when running against a Databricks workspace.
DATABRICKS_HOST=your-workspace.cloud.databricks.com
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/<warehouse-id>
DATABRICKS_SECRET_SCOPE=aviation-optimiser-secrets

# Choose one supported authentication method. Never commit real values.
# DATABRICKS_TOKEN=
# DATABRICKS_CLIENT_ID=
# DATABRICKS_CLIENT_SECRET=

# Storage and optional model overrides.
OPTI_VOLUME_BASE=/Volumes/<catalog>/<schema>/tail_allocation
# OPTI_MODELS_DIRECTORY=/absolute/path/to/model-artifacts
# SOLVER_BACKEND=highs
